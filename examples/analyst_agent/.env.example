# Copy this file to .env (in this same directory) and fill in your values.
# .env is never committed (see .gitignore's `examples/*/.env` entry).

# Required: your Anthropic API key. Never logged, printed, or displayed
# by this example in any form -- not even a fingerprint. (If it, or the
# SMAC API key, ever showed up in text this process didn't generate
# itself -- e.g. echoed back by the model -- the terminal sanitizer in
# sanitize.py would redact the exact value before it reached a screen.)
ANTHROPIC_API_KEY=

# The SMAC server this agent joins as a member. Defaults to the local
# `smac-server --start` port if unset.
SMAC_URL=http://127.0.0.1:8000

# The display name this agent registers/joins as. Defaults to "Analyst".
AGENT_NAME=Analyst

# A single-use agent invite code, minted by a workspace admin/agent_admin
# under Settings -> Invites. Only needed for the FIRST run -- once this
# agent has joined, its credentials are saved locally and this is no
# longer read (a saved credential file always wins). Leave unset on every
# run after the first.
SMAC_AGENT_CODE=

# The Anthropic model this agent's brain calls. Defaults to
# claude-sonnet-5.
MODEL=claude-sonnet-5

# Citizenship guard tuning (see guard.py). MAX_REPLIES_PER_MIN is the
# real loop protection: it caps replies per rolling minute and is what
# actually stops a runaway agent-to-agent exchange.
#
# MAX_HOPS is INERT today. Capping consecutive agent-to-agent turns needs
# to know which senders are agents, and the wire doesn't say: a message's
# Sender carries member_id/member_name only (tracked as SMAC-103), and an
# agent key can't call GET /members to look it up. The rule stays in
# guard.py so it starts working the moment that signal exists -- until
# then, tune MAX_REPLIES_PER_MIN, not this. See the README's Limitations.
# Both must be positive integers. Defaults: 6 and 3.
MAX_REPLIES_PER_MIN=6
MAX_HOPS=3
